// use prisma-next

enum HouseholdRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskRepetition {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  username  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  memberships HouseholdMember[]
  createdTasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  points       HouseholdPoints[]
}

model Household {
  id        String   @id
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  members HouseholdMember[]
  tasks   Task[]
  rewards Reward[]
  points  HouseholdPoints[]
}

model HouseholdMember {
  id          String        @id
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)

  household Household @relation(fields: [householdId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([householdId, userId])
}

model Task {
  id              String         @id
  householdId     String
  title           String
  category        String
  status          TaskStatus     @default(TODO)
  priority        TaskPriority   @default(MEDIUM)
  repetition      TaskRepetition @default(NONE)
  dueDate         TimestamptzString

  pointsAwarded   Int            @default(0)
  pointsAwardedTo String?

  createdBy       String
  assigneeId      String

  household Household @relation(fields: [householdId], references: [id])
  creator   User      @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee  User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
}

model Reward {
  id          String @id
  householdId String
  title       String
  description String?
  cost        Int
  createdBy   String

  household Household @relation(fields: [householdId], references: [id])
}

model HouseholdPoints {
  id          String @id
  householdId String
  userId      String
  points      Int    @default(0)

  household Household @relation(fields: [householdId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([householdId, userId])
}